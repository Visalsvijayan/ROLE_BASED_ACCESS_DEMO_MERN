# Copy this file to ".env" and fill in the values.   NEVER commit ".env".
# The server refuses to start if a required value is missing or too weak.

# ---- Server -------------------------------------------------------------
NODE_ENV=development
PORT=8000

# ---- Database -----------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/mern_rbac_ecommerce

# ---- JWT secrets (REQUIRED, at least 32 characters, must be different) --
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---- CORS and cookies ---------------------------------------------------
# Frontend URL(s) allowed to call this API. Several? Separate them with commas.
CLIENT_URL=http://localhost:5173
# lax  = frontend and API on the same site (local dev, or a proxy/rewrite in production)
# none = frontend and API on DIFFERENT sites (needs HTTPS)
COOKIE_SAME_SITE=lax

# ---- Production only ----------------------------------------------------
# How many reverse proxies sit in front of the API (Render, Heroku, Nginx = 1).
TRUST_PROXY=0
BCRYPT_ROUNDS=12
