# Copy this file to ".env" if you need to change anything. NEVER put secrets here:
# every VITE_* value is compiled into the JavaScript that users download.

# Where the browser sends API requests.
#   "/api"  (default) -> same origin. In development Vite forwards it to the backend;
#                        in production your host should forward it (see the README).
#   or a full URL like https://api.example.com/api  (needs COOKIE_SAME_SITE=none on the backend)
VITE_API_URL=/api

# Development only: which backend the Vite dev server forwards "/api" to.
DEV_API_TARGET=http://localhost:8000
